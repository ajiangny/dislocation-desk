# Copy to .env and fill in. Never commit .env.

# Claude API key for the "why it moved" explanations. Without it the app uses a plain fallback.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
CLAUDE_MODEL=

# SEC requires a User-Agent naming you, e.g. "Jane Doe jane@example.com". Needed for EDGAR search.
SEC_USER_AGENT=

# Optional: where the DuckDB cache lives (default: data/cache.duckdb)
DD_CACHE_PATH=
